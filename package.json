{
  "name": "@reflector/oracle-client",
  "version": "7.2.0-rc1",
  "description": "Client bindings for Reflector contract",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js -i",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js -i --config jest.integration.config.js",
    "tx-gen": "cd ./test/dao && node tx-generation.js"
  },
  "author": "team@stellar.expert",
  "license": "MIT",
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/test/(oracle|dao|subscriptions)/"
    ]
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": ">=17"
  },
  "devDependencies": {
    "@stellar-expert/eslint-config-js": "github:stellar-expert/eslint-config-js",
    "jest": "^30.4.2",
    "tslib": "2.8.1",
    "@reflector/reflector-subscription-encryption": "github:reflector-network/reflector-subscription-encryption#v1.0.1"
  }
}
